  {
   "name": "batch_generate_profiles",
   "title": "Generate many profiles",
   "description": "Creates up to 50 profiles at once with unique generated fingerprints and, by default, one working proxy each from your pool (proxySource unique; optionally from one country). Proxies are live-checked first; profiles meant to have a proxy are never created without one. Asks the user first. Long runs continue in the background: follow them with get_run_status.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
     },
     "country": {
      "type": "string",
      "pattern": "^[A-Za-z]{2}$"
     },
     "proxySource": {
      "description": "unique (default): one unused working proxy each; pool: reuse working proxies; free: working free proxies (not for logged-in accounts); none: no proxy.",
      "type": "string",
      "enum": [
       "unique",
       "pool",
       "free",
       "none"
      ]
     },
     "proxyGroupId": {
      "description": "Only take proxies from this proxy group.",
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
     },
     "group": {
      "description": "Existing group for the new profiles.",
      "anyOf": [
       {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
       },
       {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
       }
      ]
     },
     "newGroupName": {
      "description": "Create this group for them instead.",
      "type": "string",
      "minLength": 1,
      "maxLength": 80
     },
     "namePrefix": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
     },
     "os": {
      "type": "string",
      "enum": [
       "Windows",
